# Tires4Today backend - environment template. Copy to .env and fill in. Never commit real values.

# External PostgreSQL connection string (for example, Supabase or Railway).
# In Replit, store this as the TIRES4TODAY_DATABASE_URL Secret.
# If unset, the app falls back to DATABASE_URL for local/non-Replit environments.
TIRES4TODAY_DATABASE_URL=
# Use a SEPARATE database for staging and production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# staging | production. Anything other than "staging"/"development" is treated as production:
# the architecture review endpoint is disabled and demo data is hidden from public results.
APP_ENV=staging

# Site-wide search-engine indexing switch. Keep false until Sam approves public launch.
# A city page is indexable only if this is true AND cities.seo_indexable AND the city is live.
SITE_INDEXING_ENABLED=false

# Comma-separated list of allowed frontend origins, e.g. https://tires4today.ca
CORS_ORIGINS=https://your-frontend-domain

# ---- Added in later checkpoints (documented now, not used yet) ----
# Checkpoint 5 - admin sign-in allowlist (comma-separated)
# ADMIN_EMAILS=sbnem68@gmail.com
# Checkpoint 7 - email notifications (provider chosen at Checkpoint 7)
# EMAIL_API_KEY=
# EMAIL_FROM=
# OPERATOR_ALERT_EMAIL=
# PUBLIC_APP_URL=https://tires4today.ca
# Future - SMS (optional)
# SMS_ACCOUNT_ID=
# SMS_AUTH_TOKEN=
# SMS_FROM_NUMBER=
